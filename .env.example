# DiffBeacon Environment Configuration

# Django Settings
DEBUG=True
SECRET_KEY=diffbeacon-local-insecure-dev-key-change-in-production-use
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Database Configuration
# Defaults to SQLite for immediate zero-config local run
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL:
# DATABASE_URL=postgres://diffbeacon:diffbeacon@localhost:5432/diffbeacon_db

# Pluggable AI Provider Configuration
# Options: mock | openai | anthropic
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# Ingestion & Security Limits
MAX_ARCHIVE_SIZE_MB=25
MAX_UNCOMPRESSED_SIZE_MB=100
MAX_FILE_COUNT=1000
STORAGE_DIR=storage/snapshots/

# GitHub App (preferred integration)
# Create a GitHub App at https://github.com/settings/apps/new
# Required values:
# - GITHUB_APP_ID: numeric app ID from the GitHub App settings page
# - GITHUB_APP_SLUG: the app slug shown in the URL, e.g. diffbeacon-dev
# - GITHUB_APP_PRIVATE_KEY: the PEM private key contents with newlines escaped as \n
# Example:
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=diffbeacon-dev
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Optional webhook secret for PR webhooks:
# GITHUB_WEBHOOK_SECRET=replace-with-a-secure-random-string
# Redirect target after an app installation completes; typically http://localhost:5173/dashboard
# GITHUB_APP_REDIRECT_URL=http://localhost:5173/dashboard
# Optional legacy PAT fallback: not the default architecture
# GITHUB_TOKEN=

